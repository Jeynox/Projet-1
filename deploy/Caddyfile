# Bloc ajouté au Caddyfile du serveur (/etc/caddy/Caddyfile).
# Caddy obtient et renouvelle seul le certificat HTTPS (Let's Encrypt) ; http:// redirige vers https://.
wild-tour.daniellemosjose.fr {
	encode zstd gzip

	request_body {
		max_size 1MB
	}

	header {
		-Server
		-Via
		-X-Powered-By
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
	}

	reverse_proxy 127.0.0.1:3200 {
		transport http {
			dial_timeout 5s
			response_header_timeout 30s
		}
	}

	log {
		output file /var/log/caddy/wild-tour.log {
			roll_size 10MiB
			roll_keep 5
		}
		format json
	}
}
