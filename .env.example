# Modèle de configuration : copier en .env sur le serveur et remplir.
# Le fichier .env n'est jamais versionné (voir .gitignore) et n'est pas
# accessible depuis le web (voir .htaccess et deploy/nginx.conf).
#
# Aujourd'hui le site ne lit aucune variable : le formulaire de contact
# n'envoie rien. Ces variables servent le jour où l'envoi d'emails est branché.

APP_ENV=production

# Envoi des messages du formulaire de contact
SMTP_HOST=smtp.exemple.fr
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
CONTACT_TO=contact@exemple.fr
